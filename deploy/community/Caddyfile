{
	email {$KODERA_ACME_EMAIL}
	servers {
		timeouts {
			read_header 10s
			read_body 300s
			idle 120s
		}
	}
}

# Caddy is the only proxy of this profile, so the client address an upstream reads is the peer
# Caddy accepted, never a value the client sent. No `trusted_proxies` is declared: nothing sits
# in front of Caddy. Every upstream imports this.
(client_address) {
	header_up X-Forwarded-For {remote_host}
	header_up -X-Real-IP
	header_up -Forwarded
}

{$KODERA_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
		defer
	}
	header ?X-Content-Type-Options "nosniff"
	header ?X-Frame-Options "DENY"
	header ?Referrer-Policy "strict-origin-when-cross-origin"
	header ?Permissions-Policy "accelerometer=(), autoplay=(self), browsing-topics=(), camera=(self), display-capture=(self), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(self), midi=(), payment=(), picture-in-picture=(self), publickey-credentials-get=(self), screen-wake-lock=(self), serial=(), speaker-selection=(self), usb=(), xr-spatial-tracking=()"

	# The agent API and staff plane are never exposed on the public Community ingress.
	@internal path /agent /agent/* /staff /staff/*
	handle @internal {
		respond 404
	}

	@api path /api/* /health/*
	handle @api {
		request_body {
			max_size 1MiB
		}
		reverse_proxy server:8000 {
			import client_address
		}
	}

	# Exact mobile association routes only; /.well-known/matrix/* stays on web:8080.
	@mobile_association path /.well-known/apple-app-site-association /.well-known/assetlinks.json
	handle @mobile_association {
		request_body {
			max_size 1MiB
		}
		reverse_proxy server:8000 {
			import client_address
		}
	}

	# Exact WebSocket route; /internal/transform is never published.
	@documents path /documents/collab
	handle @documents {
		reverse_proxy yjs-collab:8098 {
			import client_address
		}
	}

	@room_access path /_kodera/rooms/token
	handle @room_access {
		rewrite * /token
		reverse_proxy room-access:8095 {
			import client_address
		}
	}

	# Client API only. Federation and key routes stay closed (README.md, "Federation").
	# Legacy unauthenticated /_matrix/media/*/download/* and /thumbnail/* routes fall through to 404.
	@matrix path /_matrix/client/* /_matrix/media/v3/upload /_matrix/media/v3/upload/* /_matrix/media/v1/create /_matrix/media/v3/config /_synapse/client/*
	handle @matrix {
		reverse_proxy synapse:8008 {
			import client_address
			header_down Access-Control-Allow-Origin "https://{$KODERA_DOMAIN}"
			header_down -Server
			header_down Access-Control-Expose-Headers "(?i)(?:,\s*server(\s*,|$)|^\s*server\s*,\s*|^\s*server\s*$)" "$1"
		}
	}

	@matrix_closed path /_matrix /_matrix/* /_synapse /_synapse/*
	handle @matrix_closed {
		respond 404
	}

	@livekit path /rtc /rtc/*
	handle @livekit {
		reverse_proxy livekit:7880 {
			import client_address
		}
	}

	handle {
		reverse_proxy web:8080 {
			import client_address
		}
	}
}
