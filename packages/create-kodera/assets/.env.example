# Kodera Community Self-Host Configuration (.env.example)
# Copy to .env (`cp .env.example .env`) and replace all CHANGE_ME_* placeholders before running `docker compose up -d`.
#
# Key generation commands:
#   Hex secrets (64 chars, URL-safe, >= 50 chars):  openssl rand -hex 32
#   32-byte AES-256-GCM base64url seal keys (44 chars):  openssl rand -base64 32 | tr '+/' '-_'

# Topology (README.md, "Topologies"): `single` serves the web client and every backend on
# KODERA_DOMAIN. `split` serves only the backends, on api.<KODERA_MATRIX_DOMAIN>,
# matrix.<KODERA_DOMAIN> and livekit.<KODERA_DOMAIN>, for a web client hosted at
# https://<KODERA_DOMAIN> elsewhere; run it with `-f docker-compose.yml -f docker-compose.split.yml`.
KODERA_TOPOLOGY=single

# Public DNS hostname & ACME TLS contact (matching SelfHostDeploymentPlan public config).
# In the split topology this is the web client host and the Matrix server name.
KODERA_DOMAIN=chat.example.org
# Base domain, without the tenant slug: community.example.org uses example.org.
KODERA_MATRIX_DOMAIN=example.org
KODERA_ACME_EMAIL=ops@example.org
# The API host: KODERA_DOMAIN in the single topology, api.<KODERA_MATRIX_DOMAIN> in the split one.
DJANGO_ALLOWED_HOSTS=chat.example.org,127.0.0.1

# Sign-in (README.md, "Sign-in"). The stack runs no identity provider: bring an OIDC issuer.
# The web client signs in at this origin, under its /realms/<name>/ paths (a Keycloak-style layout).
KODERA_OIDC_PROVIDER_ORIGIN=https://id.example.org
KODERA_OIDC_CLIENT_ID=console
# The issuers the server trusts, as one JSON list on one line, in single quotes:
#   '[{"lane":"customer","issuer":"https://id.example.org/realms/<name>","generation":"<label>",
#      "expires_at":<unix seconds>,"public_jwks":{"keys":[...]}}]'
# At most 8 entries; each issuer a public https URL. The server refuses to start on anything else.
KODERA_AUTH_TRUST=CHANGE_ME_SEE_README_SIGN_IN
# Optional exact /realms/kodera-staff issuer, admitted on the staff trust lane.
KODERA_STAFF_ISSUER=

# Canonical shared workspace. Leave all three empty for an unrelated isolated self-host.
# The issuer must be admitted on the customer lane and end in /realms/community.
# The owner must already be a real User row; bootstrap never invents an account.
KODERA_DEFAULT_COMMUNITY_ORG_SLUG=community
KODERA_DEFAULT_COMMUNITY_ISSUER=CHANGE_ME_EXACT_COMMUNITY_ISSUER
KODERA_DEFAULT_COMMUNITY_OWNER_USER_ID=CHANGE_ME_EXISTING_OWNER_UUID
# Isolated tenant-agent credentials, obtained by operator enrollment and Synapse provisioning.
# Never substitute random values for issued credentials. Empty when Community bootstrap is off.
KODERA_AGENT_TOKEN=CHANGE_ME_ENROLLED_TENANT_AGENT_TOKEN
KODERA_SYNAPSE_TOKEN=CHANGE_ME_SYNAPSE_AGENT_ADMIN_TOKEN

# Matrix sign-in (README.md, "Matrix sign-in"). Synapse signs members in through the confidential
# OIDC client `synapse` of your realm; the secret is issued by your identity provider, never random.
# The canonical Community workspace uses KODERA_DEFAULT_COMMUNITY_ISSUER: leave the issuer below
# empty. An isolated self-host sets its own realm issuer here, admitted on the customer trust lane.
# Leave both empty to run without Matrix sign-in.
KODERA_SYNAPSE_OIDC_ISSUER=
KODERA_SYNAPSE_OIDC_CLIENT_SECRET=CHANGE_ME_ISSUED_SYNAPSE_CLIENT_SECRET

# Matrix federation is closed. To open it to named servers only, list them here, comma-separated
# (README.md, "Federation"). Leave empty to keep the homeserver closed.
KODERA_MATRIX_FEDERATION_ALLOWLIST=

# PostgreSQL 17 (`openssl rand -hex 32` — URL-safe hex, no `/` or `@`)
POSTGRES_USER=kodera
POSTGRES_DB=kodera_server
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
# Synapse's own PostgreSQL 17 database, isolated from the server's (`openssl rand -hex 32`)
SYNAPSE_POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Kodera Server Admitted Secrets (ADR-0003)
# DJANGO_SECRET_KEY requires 50..512 non-whitespace chars -> generate with: openssl rand -hex 32
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
# AES-256-GCM 32-byte base64url seal keys -> generate each with: openssl rand -base64 32 | tr '+/' '-_'
KODERA_CONTACT_SEAL_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64URL_32
KODERA_OUTBOX_SEAL_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64URL_32
# HMAC keys -> generate each with: openssl rand -hex 32
KODERA_MEMBERSHIP_CURSOR_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
KODERA_DISCOVERY_HMAC_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Room-Access & LiveKit SFU Credentials (isolated from `server` per ADR-0003 & ADR-0018)
ROOM_ACCESS_MATRIX_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
LIVEKIT_API_KEY=CHANGE_ME_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
