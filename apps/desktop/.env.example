# @kodera/desktop environment template (example values only — NEVER commit a real .env file).
# Copy keys to your local shell or CI runner secret store when building signed installers.

# -----------------------------------------------------------------------------
# Local Development & Packaging Mode
# -----------------------------------------------------------------------------
# Set to 1 to build only the native Rust host (`kodera-desktop`) and bundle manifest
# when the Tauri OS bundler CLI or native WebKitGTK/AppImage toolchains are absent.
KODERA_DESKTOP_HOST_ONLY=0

# Optional override directory for Cargo build artifacts on shared workstations.
# CARGO_TARGET_DIR=/path/to/shared/cargo-target

# -----------------------------------------------------------------------------
# macOS Code Signing & Apple Notarization (.app / .dmg)
# -----------------------------------------------------------------------------
# Developer ID Application certificate common name in login keychain (or "-" for ad-hoc local builds)
APPLE_SIGNING_IDENTITY=
# Apple Developer Team ID (10-character alphanumeric identifier)
APPLE_TEAM_ID=
# Apple ID email used for notarytool submission
APPLE_ID=
# App-specific credential for notarytool (stored in CI secret manager, never committed)
APPLE_PASSWORD=
# Base64-encoded .p12 Developer ID certificate for ephemeral CI keychains
APPLE_CERTIFICATE=
APPLE_CERTIFICATE_PASSWORD=

# -----------------------------------------------------------------------------
# Windows Authenticode Signing (.msi / NSIS -setup.exe)
# -----------------------------------------------------------------------------
# SHA-1 thumbprint of the code-signing certificate in the Windows Certificate Store
WINDOWS_CERTIFICATE_THUMBPRINT=
# RFC 3161 timestamp server URL used by signtool.exe
WINDOWS_TIMESTAMP_URL=http://timestamp.digicert.com

# -----------------------------------------------------------------------------
# Linux & Tauri Release Artifact Signing (.AppImage / .deb / update metadata)
# -----------------------------------------------------------------------------
# Minisign private key content or path used by `tauri signer` for release verification
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
