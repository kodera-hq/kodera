# Synthetic local settings only. Compose passes an explicit allowlist to each
# service; never source this backing-services file into an API process.
# The runtime does not load .env. No provisioning credential belongs here.

# API settings. Debug must remain disabled; only local hosts are supported.
DJANGO_SECRET_KEY=local-bootstrap-only-not-a-deployment-key
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL is for an explicitly configured host process. Compose constructs
# its own URL from the POSTGRES values below, with its private service name db.
DATABASE_URL=postgres://kodera:kodera@127.0.0.1:5432/kodera_server

# Choose unused loopback ports and a unique compose project for each worktree.
CORE_API_PORT=8000
CORE_DB_PORT=5432
POSTGRES_DB=kodera_server
POSTGRES_USER=kodera
POSTGRES_PASSWORD=kodera

# Optional identity fixture only; never forwarded to the API.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Test doubles only. No queue or provisioning runtime exists yet.
FAKE_TOFU_FAIL=

# Core mail sender (docs/specs/OUTBOX_MAIL_SENDER.md §6), read by config.settings.job_queue.
# Locally: the compose Mailpit, plaintext to loopback or localhost only. Elsewhere smtp://user@host:587, which
# requires STARTTLS, with KODERA_MAIL_SMTP_PASSWORD injected from the secret store.
KODERA_MAIL_SMTP_URL=smtp+insecure://localhost:1025
KODERA_MAIL_SMTP_PASSWORD=
KODERA_MAIL_FROM=Kodera <no-reply@notify.localhost>
KODERA_MAIL_REPLY_TO=support@kodera.io
# The console origins a message may link to, comma-separated.
KODERA_MAIL_LINK_ORIGINS=http://localhost:5173
# 32 random bytes, URL-safe base64; generate your own local one with
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# No default: unset, no message can be enqueued.
KODERA_OUTBOX_SEAL_KEY=

# Optional Enterprise Edition compliance audit-export signing seed (32..512 printable ASCII chars,
# injected from the application secret store when KODERA_EDITION=enterprise). Unset: falls back to
# SECRET_KEY derivation while persisting verification public keys in ee_audit_signing_key.
KODERA_EE_AUDIT_SIGNING_SEED=

# Optional internal room-access endpoint verifying Matrix DM room membership for attachments
# (e.g. http://room-access:8096/internal/room-member on the private compose network).
KODERA_MEDIA_ROOM_VERIFIER_URL=

# Optional Matrix worker settings for dispatch_extension_coexistence (queued Matrix history
# imports and inbound coexistence deliveries), read by the operator/worker profiles. Unset, the
# command refuses to run instead of silently draining nothing. KODERA_SYNAPSE_ADMIN_TOKEN is a
# homeserver admin access token injected from the secret store, never committed; set
# KODERA_MATRIX_REPLAY_TRANSPORT_FACTORY (a dotted Python path) to override the default
# homeserver transport built from KODERA_SYNAPSE_URL + KODERA_SYNAPSE_ADMIN_TOKEN.
KODERA_SYNAPSE_URL=
KODERA_SYNAPSE_ADMIN_TOKEN=
KODERA_SYNAPSE_SERVER_NAME=
KODERA_MATRIX_REPLAY_TRANSPORT_FACTORY=

# Optional sovereign AI gateway (strictly OFF by default; also requires org, channel and member opt-in).
# KODERA_AI_SEAL_KEY is a 32-byte URL-safe base64 master key for HKDF-sealing BYOM tenant configs;
# KODERA_AI_MISTRAL_API_KEY is injected from the application secret store when managed Mistral EU is used.
KODERA_AI_GATEWAY_ENABLED=false
KODERA_AI_SEAL_KEY=
KODERA_AI_MISTRAL_API_KEY=
KODERA_AI_ACTOR_SUBJECTS=
KODERA_AI_CLIENT_IDS=
# Optional LiveKit RoomService endpoint and HS256 API key/secret for authoritative live-call
# caption roster verification (injected from the application secret store; unset fails closed 503).
# KODERA_LIVEKIT_ROOM_SERVICE_URL=
# KODERA_LIVEKIT_API_KEY=
# KODERA_LIVEKIT_API_SECRET=

# Optional HKDF master seal key (32-byte URL-safe base64, injected from the application secret store)
# for sealing per-workspace CalDAV source credentials at rest.
KODERA_CALENDAR_SEAL_KEY=

# Legal issuer aliases: operators must configure the complete non-synthetic required set.
# When both namespaces are present, values must match exactly. Replace every placeholder.
# SAMOURAI_BILLING_ISSUER_NAME=Example Cooperative
# SAMOURAI_BILLING_ISSUER_ADDRESS=1 Example Street
# SAMOURAI_BILLING_ISSUER_POSTAL_CODE=75000
# SAMOURAI_BILLING_ISSUER_CITY=Paris
# SAMOURAI_BILLING_ISSUER_COUNTRY=FR
# SAMOURAI_BILLING_ISSUER_SIREN=<nine-digit-Luhn-valid-registration>
# SAMOURAI_BILLING_ISSUER_VAT_NUMBER=<FR-key-and-SIREN>
# Optional nonblank legal details, when applicable:
# SAMOURAI_BILLING_ISSUER_SIRET=<fourteen-digit-Luhn-valid-establishment>
# SAMOURAI_BILLING_ISSUER_LEGAL_FORM=<registered-legal-form>
# SAMOURAI_BILLING_ISSUER_SHARE_CAPITAL=<registered-capital>
# SAMOURAI_BILLING_ISSUER_RCS=<commercial-register>
# SAMOURAI_BILLING_ISSUER_NAF=<activity-code>
# KODERA_BILLING_VERAPDF=/opt/verapdf/verapdf
# Always-on structural PDF/A-3b and EN 16931 XSD/Schematron checks need billing-documents extra.
# Enterprise PA transport is disabled by default; the token belongs in the operator secret store.
QONTO_EINVOICING_ENABLED=false
# QONTO_EINVOICING_BASE_URL=https://thirdparty.qonto.com
QONTO_EINVOICING_TIMEOUT_SECONDS=10

# Dedicated billing worker RPC; media gateway configuration does not enable billing downloads.
# KODERA_BILLING_GATEWAY_SOCKET=/run/kodera/billing-gateway.sock
