# Synthetic local settings only. Compose passes an explicit allowlist to each
# service; never source this backing-services file into an API process.
# The runtime does not load .env. No provisioning credential belongs here.

# API settings. Debug must remain disabled; only local hosts are supported.
DJANGO_SECRET_KEY=local-bootstrap-only-not-a-deployment-key
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL is for an explicitly configured host process. Compose constructs
# its own URL from the POSTGRES values below, with its private service name db.
DATABASE_URL=postgres://kodera:kodera@127.0.0.1:5432/kodera_server

# Choose unused loopback ports and a unique compose project for each worktree.
CORE_API_PORT=8000
CORE_DB_PORT=5432
POSTGRES_DB=kodera_server
POSTGRES_USER=kodera
POSTGRES_PASSWORD=kodera

# Optional identity fixture only; never forwarded to the API.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Test doubles only. No queue or provisioning runtime exists yet.
FAKE_TOFU_FAIL=

# Core mail sender (docs/specs/OUTBOX_MAIL_SENDER.md §6), read by config.settings.job_queue.
# Locally: the compose Mailpit, plaintext to loopback or localhost only. Elsewhere smtp://user@host:587, which
# requires STARTTLS, with KODERA_MAIL_SMTP_PASSWORD injected from the secret store.
KODERA_MAIL_SMTP_URL=smtp+insecure://localhost:1025
KODERA_MAIL_SMTP_PASSWORD=
KODERA_MAIL_FROM=Kodera <no-reply@notify.localhost>
KODERA_MAIL_REPLY_TO=support@kodera.io
# The console origins a message may link to, comma-separated.
KODERA_MAIL_LINK_ORIGINS=http://localhost:5173
# 32 random bytes, URL-safe base64; generate your own local one with
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# No default: unset, no message can be enqueued.
KODERA_OUTBOX_SEAL_KEY=
