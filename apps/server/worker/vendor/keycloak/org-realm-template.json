{
  "realm": "${REALM}",
  "displayName": "${REALM}",
  "enabled": true,
  "attributes": {
    "koderaRealmSource": "org-realm-template.json"
  },
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "verifyEmail": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "loginTheme": "kodera",
  "accountTheme": "kodera",
  "emailTheme": "kodera",
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "fr"],
  "defaultLocale": "fr",
  "defaultSignatureAlgorithm": "ES256",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 1209600,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 7776000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "actionTokenGeneratedByAdminLifespan": 86400,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": false,
  "browserFlow": "kodera browser",
  "directGrantFlow": "kodera direct grant denied",
  "smtpServer": {
    "host": "smtp.tem.scaleway.com",
    "port": "587",
    "starttls": "true",
    "ssl": "false",
    "auth": "true",
    "from": "no-reply@${MAIL_DOMAIN}",
    "fromDisplayName": "Kodera",
    "replyTo": "support@kodera.io",
    "user": "${SMTP_USER}"
  },
  "authenticatorConfig": [
    {
      "alias": "kodera-amr-pwd",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "kodera-amr-otp",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "36000"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "kodera browser",
      "description": "Cookie, or password then OTP. No other path.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "kodera browser forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "kodera browser forms",
      "description": "Password and OTP, both required, each named in amr.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorConfig": "kodera-amr-pwd",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "kodera-amr-otp",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "kodera direct grant denied",
      "description": "No token from a password alone: every client's direct grant is refused.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "deny-access-authenticator",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "console",
      "name": "Kodera console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${CONSOLE_ORIGIN}",
      "baseUrl": "/",
      "redirectUris": [
        "${CONSOLE_ORIGIN}/auth/callback",
        "${CONSOLE_ORIGIN}/auth/claim-callback",
        "${CONSOLE_ORIGIN}/"
      ],
      "webOrigins": [
        "${CONSOLE_ORIGIN}"
      ],
      "attributes": {
        "access.token.lifespan": "260",
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${CONSOLE_ORIGIN}/"
      },
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "acr",
        "web-origins",
        "profile",
        "email"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "core-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "kodera-server",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "authentication-methods",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "kodera-mfa-enrolled-v1",
          "protocol": "openid-connect",
          "protocolMapper": "kodera-registered-factor-v1",
          "consentRequired": false,
          "config": {}
        }
      ]
    },
    {
      "clientId": "synapse",
      "name": "Kodera Espace (Synapse)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "${SYNAPSE_ORIGIN}/_synapse/client/oidc/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "backchannel.logout.url": "${SYNAPSE_ORIGIN}/_synapse/client/oidc/backchannel_logout",
        "backchannel.logout.session.required": "true"
      },
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "docs",
      "name": "Kodera Docs",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "frontchannelLogout": false,
      "authenticationFlowBindingOverrides": {},
      "redirectUris": [
        "${DOCS_ORIGIN}/api/v1.0/callback/"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${DOCS_ORIGIN}/api/v1.0/logout-callback/"
      },
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "optionalClientScopes": [],
      "protocolMappers": []
    },
    {
      "clientId": "${VISIO_HOST}",
      "name": "Kodera Visio",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "frontchannelLogout": false,
      "authenticationFlowBindingOverrides": {},
      "redirectUris": [
        "https://${VISIO_HOST}/api/v1.0/callback/"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "id.token.signed.response.alg": "RS256",
        "post.logout.redirect.uris": "https://${VISIO_HOST}/api/v1.0/logout-callback/",
        "backchannel.logout.url": "https://${VISIO_HOST}/api/v1.0/backchannel-logout/",
        "backchannel.logout.session.required": "true"
      },
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "optionalClientScopes": [],
      "protocolMappers": []
    },
    {
      "clientId": "kodera-identity-worker",
      "name": "Identity worker (catalogue step 3)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      }
    },
    {
      "clientId": "kodera-ios",
      "name": "Kodera for iOS",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "io.kodera.app:/oauth2redirect"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "io.kodera.app:/oauth2redirect"
      },
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "acr",
        "web-origins",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "core-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "kodera-server",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "authentication-methods",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "kodera-android",
      "name": "Kodera for Android",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "io.kodera.app:/oauth2redirect"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "io.kodera.app:/oauth2redirect"
      },
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "acr",
        "web-origins",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "core-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "kodera-server",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "authentication-methods",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
