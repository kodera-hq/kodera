# Exclude by default, including .env, Git metadata and worker input.
**
!Dockerfile
!pyproject.toml
!uv.lock
!manage.py
!config/*.py
!config/settings/*.py
# The test profile permits the job queue's mutant flags; the image never carries it.
config/settings/test.py
config/settings/e2e.py
config/settings/e2e_operator.py
config/settings/job_queue.py
config/settings/deploy_operator.py
config/settings/deploy_worker.py
