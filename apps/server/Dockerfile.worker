# Pinned, nonroot provisioning worker image (ADR-0003): `python -m worker run`, no HTTP entrypoint.
# Its build context is Dockerfile.worker.dockerignore, not .dockerignore: no URL, WSGI or API module
# and no settings profile but deploy_worker reaches this image (tests/worker, WK-09).
FROM ghcr.io/astral-sh/uv:0.12.10@sha256:2bb3ebca0a796a155094a27773d290c4b074572e6107f171d88d086682fd2500 AS uv

# realm_create runs identity realm tooling's realm-apply.sh (worker/vendor/keycloak/), which drives Keycloak
# through its admin CLI, kcadm, from Keycloak 26.8.2 (linux/amd64 manifest).
# Keep bin/client intact: the launcher selects its versioned admin CLI jar and client/lib providers.
# Derive the Java modules at build time; retain the existing reflective modules and EC for HTTPS.
# This image only: the API image holds no identity-provider client.
FROM quay.io/keycloak/keycloak:26.8.2@sha256:4da21f9a53bcbac1026a0d654b740a81e98e5de4c45457076acc74b4d94b1551 AS keycloak
FROM eclipse-temurin:21-jdk@sha256:db5cc6341a1d7bc40cdb51e1f0d9824f3bb2cc8107d29da421dc4df7d11f05f1 AS kcadm
COPY --from=keycloak /opt/keycloak/bin/kcadm.sh /opt/kcadm/bin/
COPY --from=keycloak /opt/keycloak/bin/client/ /opt/kcadm/bin/client/
RUN modules=$(jdeps --multi-release 21 --ignore-missing-deps --print-module-deps \
      --class-path '/opt/kcadm/bin/client/lib/*' \
      /opt/kcadm/bin/client/keycloak-admin-cli-*.jar /opt/kcadm/bin/client/lib/*.jar) \
    && jlink --add-modules "$modules,java.desktop,java.naming,java.security.jgss,java.sql,jdk.crypto.ec" \
      --strip-debug --no-man-pages --no-header-files --compress=zip-6 --output /opt/kcadm/jre \
    && JAVA_HOME=/opt/kcadm/jre /opt/kcadm/bin/kcadm.sh --help > /dev/null

FROM python:3.12.16-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df AS dependencies
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /build
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_DOWNLOADS=never UV_NO_CACHE=1
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --python python3.12

FROM python:3.12.16-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df AS runtime
# realm-apply.sh reads every Keycloak answer with jq and checks the target's issuer with curl.
RUN apt-get update && apt-get install -y --no-install-recommends jq curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=kcadm /opt/kcadm /opt/kcadm
ENV PATH="/opt/venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DJANGO_SETTINGS_MODULE=config.settings.deploy_worker \
    JAVA_HOME=/opt/kcadm/jre KCADM=/opt/kcadm/bin/kcadm.sh
WORKDIR /app
COPY --from=dependencies /opt/venv /opt/venv
COPY config/ ./config/
COPY core/ ./core/
COPY apps/ ./apps/
COPY worker/ ./worker/
USER 10001:10001
CMD ["python", "-m", "worker", "run"]
