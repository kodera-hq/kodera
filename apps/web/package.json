{
  "name": "@kodera/web",
  "license": "Apache-2.0",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The customer console of Kodera \u2014 client of the Core API and nothing else.",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/precompress.mjs dist",
    "build:check": "bash scripts/check-production-bundle.sh && bash scripts/check-production-bundle.sh --profile staging",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "bash scripts/visual.sh",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "spec:check": "python3 scripts/check-spec-tests.py",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "api:generate": "node scripts/api/generate.ts",
    "i18n:generate": "node scripts/i18n/generate.ts",
    "i18n:check": "node scripts/i18n/check-used-keys.ts",
    "docs:generate": "node scripts/generate-developer-docs.mjs",
    "docs:check": "node scripts/generate-developer-docs.mjs --check",
    "prebuild": "npm run docs:check",
    "test:docs:e2e": "playwright test --config playwright.docs.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@hookform/resolvers": "^6.0.2",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@kodera/design-tokens": "0.6.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tiptap/core": "3.33.1",
    "@tiptap/extension-collaboration": "3.33.1",
    "@tiptap/extensions": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/react": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "@tiptap/suggestion": "3.33.1",
    "@tiptap/y-tiptap": "3.3.0",
    "i18next": "^26.4.2",
    "livekit-client": "2.23.0",
    "matrix-js-sdk": "45.1.0",
    "oidc-client-ts": "^3.5.0",
    "openapi-fetch": "^0.17.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^17.0.15",
    "y-indexeddb": "9.0.12",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@redocly/ajv": "^8.18.3",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/node": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.32",
    "prettier": "^3.10.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "5.1.0",
    "yaml": "^2.9.1"
  },
  "msw": {
    "workerDirectory": [
      "msw"
    ]
  }
}
