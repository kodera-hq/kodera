# Names only. bin/up.sh copies this to .runtime/config (ignored by git) and fills each CHANGE_ME with a
# random throwaway value. Nothing here is a real secret: the stack serves 127.0.0.1 only.
POSTGRES_PASSWORD=CHANGE_ME
SYNAPSE_REGISTRATION_SECRET=CHANGE_ME
SYNAPSE_MACAROON_SECRET=CHANGE_ME
SYNAPSE_FORM_SECRET=CHANGE_ME
LIVEKIT_API_KEY=espace-dev
LIVEKIT_API_SECRET=CHANGE_ME
# Not 8448, the usual federation port: this homeserver serves the client API only.
SYNAPSE_PORT=8008
SYNAPSE_PUBLIC_BASEURL=http://127.0.0.1:8008/
LIVEKIT_PORT=7880
LIVEKIT_TCP_PORT=7881
KEYCLOAK_PORT=8180
KEYCLOAK_SYNAPSE_SECRET=CHANGE_ME
# Keycloak's administrator, with which the tests create their members.
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# Where the Console runs in development: Synapse sends the member back there without asking.
CONSOLE_ORIGIN=http://127.0.0.1:5173
# Audio rooms, only when CORE_SRC names a Core checkout (bin/up.sh): the edge serving the
# room-access token call on the homeserver's origin, and the tenant agent's administrator.
# bin/audio-accounts.mjs writes AGENT_MATRIX_TOKEN and ROOM_ACCESS_MATRIX_TOKEN.
EDGE_PORT=8009
AGENT_PASSWORD=CHANGE_ME
