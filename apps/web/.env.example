# Copy to `.env.local` and fill in. Values here are names and shapes only —
# never a real secret, and never a real host outside a local stack.
#
# Anything Vite exposes to the browser must start with VITE_ and is PUBLIC: it
# is inlined into the bundle at build time and readable by anyone who opens the
# page. A variable that is neither public nor prefixed is not an error, it is
# simply `undefined` at runtime, so a misspelt name here fails silently.
# The console holds no secret of any kind (README.md, "What this repo must
# never contain") — if a value must stay private, it belongs in the Core API.

# The one backend the console is allowed to call (ADR-0003). Include the
# version prefix; every other host is a bug the PR template asks about.
VITE_CORE_API_URL=http://localhost:8000/api/v1

# Keycloak base URL. Tenant admins authenticate against THEIR OWN tenant realm,
# resolved at runtime from the organisation slug or the email domain, so no
# realm is configured here (ADR-0002). Staff use the `kodera-staff` realm.
VITE_KEYCLOAK_URL=http://localhost:8080

# Set to 1 to boot the MSW worker and serve the Core API from generated mocks
# instead of the network. Used by the Playwright suite; handy for local UI work
# with no core running. Unset (or anything else) means "talk to the real
# VITE_CORE_API_URL".
VITE_ENABLE_MSW=0

# "oidc" talks to the real identity provider (ADR-0007). "mock" selects the
# test identity provider behind the same AuthAdapter interface — its route and
# MSW handlers are not in the production bundle unless this is "mock" AND
# VITE_ENABLE_MSW=1; `npm run build:check` proves it. So this is a security
# boundary as well as a local convenience.
VITE_AUTH_MODE=oidc

# The console's public OIDC client id, registered once per Keycloak realm.
# Public like every VITE_ value: PKCE is what makes a public client safe.
VITE_OIDC_CLIENT_ID=console

# The domain every organisation's Matrix server name sits under (ADR-0012):
# `{organisation slug}.{this domain}`, whose `/.well-known/matrix/client` names
# the homeserver. `kodera.io` in production, `staging.kodera.io` on staging.
# Must agree with the static server's `--matrix-domain`. Empty: the workspace
# shows its layout only and offers no live Espace.
VITE_MATRIX_DOMAIN=

# The DNS name a tenant's address sits under: Core gives a tenant
# `https://{slug}.{this domain}` (its KODERA_TENANT_APP_URLS templates), and
# the order previews that address: the domain of the main application's
# template (`messaging` today). Must agree with Core's templates.
# `staging.kodera.io` on staging. Empty: the order names no domain.
VITE_TENANT_DOMAIN=

# Development builds only (`npm run dev`): the local Espace stack's homeserver,
# a plain-HTTP origin on this machine, used in place of discovery. A production
# build never reads it.
VITE_ESPACE_DEV_HOMESERVER=

# Development builds only, with VITE_ESPACE_DEV_HOMESERVER: the local stack's
# Matrix server name (the part after `:` in its users' IDs), which decides
# whose workspace a session belongs to. Empty means `kodera.test`, the stack's
# own. A production build never reads it.
VITE_ESPACE_DEV_SERVER_NAME=

# Mock builds only, with VITE_ENABLE_MSW=1: show the screens whose Core
# operations are not served yet, which the pilot hides (docs/dev/CAPABILITIES.md).
# The end-to-end and visual suites set it. Ignored by any build that talks to a
# real Core.
VITE_MOCK_UNSERVED=
