        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisation channels"
          }
        }
      }
    },
    "workspace.readonly_hint": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les canaux sont présentés à titre informatif. Cette version ne permet pas de les ouvrir."
