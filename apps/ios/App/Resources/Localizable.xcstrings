    "passkey.description": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie localement les assertions WebAuthn P-256 liées à l’organisation avec présence et vérification biométrique ou code de l’appareil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locally verifies organisation-bound P-256 WebAuthn assertions requiring user presence and device user verification."
          }
        }
      }
    },
    "passkey.policy_summary": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil universel ES256 WebAuthn L3 (drapeaux 0x05, 0x0D et 0x1D avec UP+UV, compteur monotone, refus de 0x15 et des défis expirés)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Universal ES256 WebAuthn L3 profile (0x05, 0x0D and 0x1D UP+UV flags, monotonic counter, rejecting 0x15 and expired challenges)."
          }
        }
      }
    },
    "passkey.organisation_required": {
