    "passkey.unprovisioned": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérificateur ES256 prêt · Enregistrement distant non provisionné"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ES256 verifier ready · Remote registration not provisioned"
          }
