{
  "sourceLanguage": "fr",
  "strings": {
    "brand.name": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodera"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodera"
          }
        }
      }
    },
    "welcome.title": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre équipe, à portée de main."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your team, within reach."
          }
        }
      }
    },
    "welcome.description": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espace pour échanger et avancer ensemble."
