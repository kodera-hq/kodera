          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "27-byte rotating beacons (5 min window, max 10 s scan followed by 50 s cooldown, auto-paused in Low Power Mode or below 15% battery)."
          }
        }
      }
