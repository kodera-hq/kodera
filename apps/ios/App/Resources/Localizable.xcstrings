        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in was refused."
          }
        }
      }
    },
    "signin.untrusted": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce service de connexion n'est pas reconnu par l'application."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app does not recognise this sign-in service."
          }
        }
