    "signin.storage": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session n'a pas pu être enregistrée sur cet appareil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session could not be saved on this device."
          }
        }
      }
    },
    "session.ended": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session a pris fin. Reconnectez-vous."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has ended. Please sign in again."
          }
        }
      }
    },
    "session.not_wiped": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes déconnecté, mais la session n'a pas pu être effacée de cet appareil. Kodera réessaiera au prochain lancement et ne la rouvrira pas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are signed out, but the session could not be erased from this device. Kodera will try again at the next launch and will not reopen it."
          }
        }
      }
    },
