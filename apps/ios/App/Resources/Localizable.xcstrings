      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez l’identifiant fourni par votre équipe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the identifier provided by your team."
          }
        }
      }
    },
    "discovery.loading": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche de votre organisation…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searching for your organisation…"
          }
        }
      }
    },
    "discovery.cancel": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler la recherche"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel search"
          }
        }
      }
    },
    "discovery.cancelled": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez lancer une nouvelle recherche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can start a new search."
          }
        }
      }
    },
    "discovery.no_match": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune organisation ne correspond à cet identifiant. Vérifiez-le auprès de votre équipe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No organisation matches this identifier. Check it with your team."
          }
        }
      }
    },
    "discovery.choose": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs organisations correspondent. Choisissez la vôtre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several organisations match. Choose yours."
          }
        }
      }
    },
    "discovery.choose_hint": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir cette organisation pour s’y connecter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select this organisation to sign in to it."
          }
        }
      }
    },
    "discovery.selected_explanation": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisation trouvée. Connectez-vous pour accéder à son espace."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisation found. Sign in to reach its workspace."
          }
        }
      }
    },
    "discovery.input_rules": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez 5 à 20 lettres minuscules, chiffres ou tirets, avec une lettre ou un chiffre au début et à la fin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 5 to 20 lowercase letters, numbers or hyphens, with a letter or number at each end."
          }
        }
      }
    },
    "discovery.invalid_response": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne pouvons pas utiliser la réponse du service. Réessayez plus tard."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We cannot use the service response. Try again later."
          }
        }
      }
    },
    "discovery.service_unavailable": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service est momentanément indisponible. Patientez avant de réessayer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service is temporarily unavailable. Wait before trying again."
          }
        }
      }
    },
    "discovery.request_refused": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche n’a pas pu aboutir. Vérifiez l’identifiant ou réessayez plus tard."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The search could not be completed. Check the identifier or try again later."
          }
        }
      }
    },
    "discovery.rate_limited": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de recherches en peu de temps. Réessayez plus tard."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many searches in a short time. Try again later."
          }
        }
      }
    },
    "discovery.timeout": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service met trop de temps à répondre. Vous pouvez réessayer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service is taking too long to respond. You can try again."
          }
        }
      }
    },
    "discovery.offline": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre connexion à Internet, puis réessayez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your internet connection, then try again."
          }
        }
      }
    },
    "discovery.connection_unavailable": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion au service n’a pas pu être établie. Réessayez plus tard."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A connection to the service could not be established. Try again later."
          }
        }
      }
    },
